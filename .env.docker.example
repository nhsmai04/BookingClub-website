# Docker Environment Configuration for BookingClub
# Copy this file to .env and update values as needed

# ============================================
# BACKEND CONFIGURATION
# ============================================
NODE_ENV=production
PORT=5001
DB_NAME=BookingClub

# JWT Secrets - CHANGE THESE IN PRODUCTION
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production
JWT_EXPIRE=7d
REFRESH_TOKEN_EXPIRE=7d

# Email Verification & Password Reset
EMAIL_VERIFICATION_EXPIRE_MINUTES=60
PASSWORD_RESET_EXPIRE_MINUTES=30

# ============================================
# SMTP CONFIGURATION (for email sending)
# ============================================
# Leave empty if not using email features
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM=your-email@gmail.com

# ============================================
# CORS CONFIGURATION
# ============================================
CORS_ALLOWED_ORIGINS=http://localhost,http://fe:80,http://127.0.0.1

# ============================================
# COOKIE CONFIGURATION
# ============================================
# Set to true only if using HTTPS in production
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax

# ============================================
# VNPAY PAYMENT CONFIGURATION
# ============================================
VNPAY_EXPIRE_MINUTES=10
VNPAY_TMN_CODE=your-tmn-code
VNPAY_SECURE_SECRET=your-secure-secret
VNPAY_HOST=https://sandbox.vnpayment.vn
VNPAY_RETURN_URL=http://localhost/api/v1/payments/vnpay/return

# ============================================
# FRONTEND CONFIGURATION
# ============================================
VITE_BACKEND_URL=http://localhost/api
FRONTEND_URL=http://localhost

# ============================================
# DATABASE URL
# ============================================
# This is automatically set in docker-compose.yml:
# mongodb://admin:password@mongodb:27017/BookingClub?authSource=admin
# Only override if using external MongoDB
# MONGO_URI=mongodb://admin:password@mongodb:27017/BookingClub?authSource=admin
